@baseUrl = http://localhost:8000

### ==========================================
### 1. CRUD CATEGORÍAS
### ==========================================

### 1.1 Crear Categoría 1 (Pizzas) - Responde 201
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "Pizzas",
  "descripcion": "Pizzas artesanales con masa fresca"
}

### 1.2 Crear Categoría 2 (Hamburguesas) - Responde 201
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "Hamburguesas",
  "descripcion": "Hamburguesas gourmet con ingredientes frescos"
}

### 1.3 Listar todas las categorías
GET {{baseUrl}}/categorias/

### 1.4 Obtener detalle de Categoría 1
GET {{baseUrl}}/categorias/1

### 1.5 Actualizar Categoría 1
PUT {{baseUrl}}/categorias/1
Content-Type: application/json

{
  "nombre": "Pizzas",
  "descripcion": "Pizzas artesanales a la piedra con masa madre"
}

### 1.6 Eliminar una categoría (ejemplo con ID 99) - Responde 204 o 404
DELETE {{baseUrl}}/categorias/99


### ==========================================
### 2. CRUD PRODUCTOS
### ==========================================

### 2.1 Crear Producto 1 - Responde 201
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Pizza Napolitana",
  "descripcion": "Muzzarella, tomate fresco en rodajas y ajo",
  "precio_base": 11500.0,
  "imagenes_url": ["https://ejemplo.com/napolitana.jpg"],
  "disponible": true
}

### 2.2 Crear Producto 2 - Responde 201
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Hamburguesa Doble Cheddar",
  "descripcion": "Doble medallón de carne con cheddar y panceta",
  "precio_base": 9200.0,
  "imagenes_url": ["https://ejemplo.com/burger.jpg"],
  "disponible": true
}

### 2.3 Listar todos los productos
GET {{baseUrl}}/productos/

### 2.4 Obtener detalle del Producto 1
GET {{baseUrl}}/productos/1

### 2.5 Actualizar Producto 1
PUT {{baseUrl}}/productos/1
Content-Type: application/json

{
  "nombre": "Pizza Napolitana Especial",
  "descripcion": "Muzzarella, tomate natural, ajo y aceitunas",
  "precio_base": 12500.0,
  "imagenes_url": ["https://ejemplo.com/napolitana-esp.jpg"],
  "disponible": true
}

### 2.6 Eliminar un producto (ejemplo con ID 99) - Responde 204 o 404
DELETE {{baseUrl}}/productos/99


### ==========================================
### 3. RELACIÓN PRODUCTO - CATEGORÍA (ProductoCategoria)
### ==========================================

### 3.1 Asignar Categoría 1 al Producto 1 (POST /productos/{id}/categorias)
POST {{baseUrl}}/productos/1/categorias
Content-Type: application/json

{
  "categoria_id": 1
}

### 3.2 Listar las categorías asociadas al Producto 1 (GET /productos/{id}/categorias)
GET {{baseUrl}}/productos/1/categorias

### 3.3 Quitar la asociación entre Producto 1 y Categoría 1 (DELETE /productos/{id}/categorias/{categoria_id})
DELETE {{baseUrl}}/productos/1/categorias/1