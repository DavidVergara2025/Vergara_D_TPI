@baseUrl = http://localhost:8000

### ==========================================
### 0. PREPARACIÓN: CREAR PRODUCTOS E INGREDIENTES DE PRUEBA
### ==========================================

### 0.1 Crear Producto 1 (Pizza Napolitana - $11500)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Pizza Napolitana",
  "descripcion": "Muzzarella, tomate fresco y ajo",
  "precio_base": 11500.0,
  "imagenes_url": ["https://ejemplo.com/napolitana.jpg"],
  "disponible": true
}

### 0.2 Crear Producto 2 (Hamburguesa Doble - $9200)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Hamburguesa Doble",
  "descripcion": "Doble medallón con cheddar",
  "precio_base": 9200.0,
  "imagenes_url": ["https://ejemplo.com/burger.jpg"],
  "disponible": true
}

### 0.3 Crear Ingrediente de prueba
POST {{baseUrl}}/ingredientes/
Content-Type: application/json

{
  "nombre": "Queso Muzzarella"
}

### 0.4 Listar Ingredientes
GET {{baseUrl}}/ingredientes/


### ==========================================
### 1. CRUD DE PEDIDOS Y DETALLE_PEDIDO (CASOS EXITOSOS)
### ==========================================

### 1.1 Crear Pedido con 2 detalles en una sola transacción (Responde 201 Created)
# Calcula total = (2 * 11500) + (1 * 9200) = 32200.0 y estado = "PENDIENTE"
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": 1, "cantidad": 2 },
    { "producto_id": 2, "cantidad": 1 }
  ]
}

### 1.2 Listar todos los pedidos activos (no eliminados) (Responde 200 OK)
GET {{baseUrl}}/pedidos

### 1.3 Obtener detalle completo del Pedido 1 con sus renglones (Responde 200 OK)
GET {{baseUrl}}/pedidos/1

### 1.4 Actualizar el estado del Pedido 1 a CONFIRMADO (Responde 200 OK)
PUT {{baseUrl}}/pedidos/1
Content-Type: application/json

{
  "estado": "CONFIRMADO"
}


### ==========================================
### 2. VALIDACIONES Y ROLLBACK (CASOS 422 Y 404 REQUERIDOS)
### ==========================================

### 2.1 Error 422: Mismo producto_id repetido en dos detalles (RN-12)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": 1, "cantidad": 1 },
    { "producto_id": 1, "cantidad": 3 }
  ]
}

### 2.2 Error 422: Pedido sin detalles (lista vacía - RN-12)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": []
}

### 2.3 Error 422: Detalle con cantidad menor que 1
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": 1, "cantidad": 0 }
  ]
}

### 2.4 Error 422: Actualizar estado con un valor fuera de los permitidos
PUT {{baseUrl}}/pedidos/1
Content-Type: application/json

{
  "estado": "EN_PREPARACION_INVALIDO"
}

### 2.5 Error 404 + Rollback del Unit of Work: Detalle con producto inexistente (id 9999)
# El primer detalle es válido, el segundo falla con 404 y el UoW hace rollback del pedido completo
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": 1, "cantidad": 1 },
    { "producto_id": 9999, "cantidad": 2 }
  ]
}


### ==========================================
### 3. BORRADO LÓGICO (SOFT DELETE) Y VERIFICACIÓN 404
### ==========================================

### 3.1 Eliminar lógicamente el Pedido 1 (Completa deleted_at y responde 204 No Content)
DELETE {{baseUrl}}/pedidos/1

### 3.2 Verificar que el Pedido 1 ya no aparece en el listado activo
GET {{baseUrl}}/pedidos

### 3.3 Error 404: Intentar consultar un pedido eliminado lógicamente (RN-13)
GET {{baseUrl}}/pedidos/1

### 3.4 Error 404: Intentar actualizar un pedido eliminado o inexistente (RN-13)
PUT {{baseUrl}}/pedidos/1
Content-Type: application/json

{
  "estado": "ENTREGADO"
}